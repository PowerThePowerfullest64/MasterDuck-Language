The Lexer (Scanner): Reads characters one by one, strips comments and whitespace, and groups text into categorized tokens:

fn double(n: int): int {
    return n * 2;
}

[FN, IDENT("double"), LPAREN, IDENT("n"), COLON, TYPE("int"), RPAREN, 
 COLON, TYPE("int"), LBRACE, RETURN, IDENT("n"), STAR, INT(2), SEMICOLON, RBRACE]