madc:
list[int] my_list = {0, 1, 2, 3}

C++:
std::vector<int> my_list = {0, 1, 2, 3};

madc:
func fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

C++:
int fib(int n) {
    if (n < 2)
        return n;
    return fib(n - 1) + fib(n - 2);
}

